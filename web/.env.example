# App
AUTH_URL=http://localhost:3000
# Generate: openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth App (required for sign-in)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL:     http://localhost:3000
# Callback URL:     http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (optional, next to GitHub)
# Create at: https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://web-liard-chi-14.vercel.app
#   https://syncpad-staging.vercel.app
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://web-liard-chi-14.vercel.app/api/auth/callback/google
#   https://syncpad-staging.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Collab server (must match server/.env)
HOCUSPOCUS_SECRET=shared-jwt-secret-min-32-characters-long
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1234

# Gmail SMTP. Use a Google App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM=SyncPad <you@gmail.com>